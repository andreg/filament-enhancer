{
    "name": "andreg/filament-enhancer",
    "description": "Filament enhancer.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Andreg\\FilamentEnhancer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Andreg\\FilamentEnhancer\\Providers\\FilamentEnhancerServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Andrea Gandino",
            "email": "andreagandino@gmail.com"
        }
    ],
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {},
    "require-dev": {
        "filament/tables": "^5.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    }
}
